# Streamlit UI config. Copy to .env.ui.local, fill in, then: make ui
# .env.ui.local is gitignored — never commit real keys.

# ── API connection ─────────────────────────────────────────────────────────────
API_URL=http://localhost:8000
API_PREFIX=/api/v1  # must match API_PREFIX= on the server

# API key sent as X-API-Key on every request.
# Must match a key in the server's API_KEYS= (or API_KEY=) setting.
# Leave empty only when the server runs with ALLOW_OPEN_API=true.
API_KEY=your-ui-key-here

# File path to the API key (e.g. Docker secret). Takes precedence over API_KEY.
# API_KEY_FILE=/run/secrets/ui_api_key

# ── Login (UI_USERS or UI_PASSWORD — pick one) ────────────────────────────────
# Option A — per-reviewer logins: each person sees only their own screenings.
# Format: name:password,name2:password2  (name must match [A-Za-z0-9_.@-]{1,64})
# For production use scrypt hashes: python ui/login.py hash
# UI_USERS=alice:password123,bob:password456

# Option B — shared login: team shares screenings, reviewer types their name.
# UI_PASSWORD=sharedpassword

# Neither set = no login (open, local dev only).
# Set UI_REQUIRE_LOGIN=true to refuse to start without a login configured.
UI_REQUIRE_LOGIN=

# ── Session ────────────────────────────────────────────────────────────────────
UI_SESSION_TIMEOUT_MINUTES=30  # sign out after this many minutes of inactivity

# ── Proxy ──────────────────────────────────────────────────────────────────────
# UI_BEHIND_PROXY=true  # set if behind a reverse proxy (reads X-Forwarded-For for rate limiting)

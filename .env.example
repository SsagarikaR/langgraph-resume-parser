# API server configuration. Copy to .env and fill in. Only GEMINI_API_KEY is required.
# In production use /run/secrets/<setting_name> files instead (Docker secrets).

# ── LLM ───────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=                          # required
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=                   # backup model when the main one fails; empty = none
EMBEDDING_MODEL=gemini-embedding-001
LLM_TEMPERATURE=0
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=3
LLM_NODE_ATTEMPTS=2                      # attempts per LLM graph node (retries bad/failed responses)

# ── Vector store (Qdrant) ─────────────────────────────────────────────────────
QDRANT_URL=                              # empty = local file mode at QDRANT_PATH
QDRANT_API_KEY=
QDRANT_PATH=qdrant_data

# ── Storage ───────────────────────────────────────────────────────────────────
CHECKPOINT_DB=checkpoints.db
REPORTS_DIR=reports
UPLOADS_DIR=data/uploads
KNOWLEDGE_BASE_DIR=data/knowledge_base

# ── Screening rules ───────────────────────────────────────────────────────────
MATCH_THRESHOLD=70                       # skill match % for the strong-match route
EXPERIENCE_TOLERANCE_YEARS=0.5          # years under the requirement still counts as a match
MAX_REVISIONS=3                          # reviewer revision rounds before the report is forced
GUIDELINE_TOP_K=4
GUIDELINE_MIN_SCORE=0.6

# ── Input limits ──────────────────────────────────────────────────────────────
MAX_UPLOAD_MB=10
MAX_DOCUMENT_CHARS=50000                 # resume/JD characters sent to the LLM; longer = 400
PDF_TIMEOUT_SECONDS=30                   # PDF extraction child process timeout

# ── Data retention ────────────────────────────────────────────────────────────
RETENTION_DAYS=30                        # screenings idle this many days are auto-erased; 0 = keep forever
PURGE_INTERVAL_MINUTES=60               # how often the API checks for expired screenings

# ── API authentication ────────────────────────────────────────────────────────
# With both API_KEYS and API_KEY empty the server refuses to start unless ALLOW_OPEN_API=true.
# Generate a key: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Store as a hash:  python -c "import hashlib,getpass; print('sha256:'+hashlib.sha256(getpass.getpass().encode()).hexdigest())"
API_KEYS=ui:your-ui-key,alice:her-key   # name:key pairs; each name owns its screenings
API_KEY=                                 # single key named "default" (simpler alternative to API_KEYS)
ALLOW_OPEN_API=                          # true = no auth (local dev only)
API_KEY_EXPIRES=                         # e.g. alice:2027-03-31,ci:2026-12-31
AUDIT_KEYS=                              # read-only keys that see every screening (GET only)
ACTING_USER_KEYS=default                 # keys allowed to send X-Acting-User (the UI's key)
API_PREFIX=/api/v1                       # version prefix for all /screenings routes (must match UI's API_PREFIX)
API_DOCS=                                # empty = on only when no key set; true/false to force
CORS_ORIGINS=                            # comma-separated browser origins; empty = none

# ── Rate limits ───────────────────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60                 # per person (caller, session, or IP for invalid keys)
WORKFLOW_RATE_LIMIT_PER_MINUTE=5        # per person for POST (LLM runs)
KEY_RATE_LIMIT_PER_MINUTE=600           # per API key (all its people together)
KEY_WORKFLOW_RATE_LIMIT_PER_MINUTE=30
KEY_DAILY_WORKFLOW_LIMIT=500            # POST requests per key per 24 h; 0 = none
DAILY_TOKEN_BUDGET=5000000              # LLM tokens server-wide per 24 h; 0 = none
MAX_CONCURRENT_RUNS=8                    # workflow runs at once; more get 503

# ── Observability ─────────────────────────────────────────────────────────────
METRICS_ENABLED=true                     # GET /metrics (Prometheus format, no key needed)
LOG_LEVEL=INFO
LOG_FORMAT=text                          # text or json (for log collectors)
# LANGSMITH_TRACING=true                 # opt-in LLM call tracing (resume data leaves the server)
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=resume-screening

# ── Streamlit UI ──────────────────────────────────────────────────────────────
# See .env.ui for the full UI configuration. These are the keys docker compose needs here too.
API_URL=http://localhost:8000
UI_USERS=                                # name:password pairs; each reviewer sees only their screenings
UI_PASSWORD=                             # shared login (one password, reviewers type their name)
UI_REQUIRE_LOGIN=                        # true = refuse to start if no login is configured
UI_SESSION_TIMEOUT_MINUTES=30
UI_BEHIND_PROXY=                         # true = read X-Forwarded-For for rate limiting

# ── Docker / production ───────────────────────────────────────────────────────
SITE_ADDRESS=localhost                   # domain Caddy serves HTTPS for
GRAFANA_ADMIN_PASSWORD=                  # for docker-compose.monitoring.yml

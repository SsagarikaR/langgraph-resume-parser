# Copy to .env and fill in. Only GEMINI_API_KEY is required.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=gemini-embedding-001
LLM_TEMPERATURE=0
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=3

# Qdrant: leave QDRANT_URL empty to use local mode in QDRANT_PATH
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_PATH=qdrant_data

# Storage (relative paths resolve from the project root)
CHECKPOINT_DB=checkpoints.db
REPORTS_DIR=reports
UPLOADS_DIR=data/uploads
KNOWLEDGE_BASE_DIR=data/knowledge_base

# Screening rules: skill match % for the strong-match route (gap analysis is skipped),
# and reviewer revisions allowed before the report is written anyway
MATCH_THRESHOLD=70
MAX_REVISIONS=3

# Guideline search: chunks returned per lookup and the minimum cosine similarity (0-1)
GUIDELINE_TOP_K=4
GUIDELINE_MIN_SCORE=0.6

MAX_UPLOAD_MB=10
# Text extraction from an uploaded PDF runs in a child process, killed after this many seconds
PDF_TIMEOUT_SECONDS=30

# HTTP API: comma-separated browser origins allowed by CORS (empty = none)
CORS_ORIGINS=
# Per-client-IP limits, per minute. Counts are in memory, per worker process.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
WORKFLOW_RATE_LIMIT_PER_MINUTE=5
LOG_LEVEL=INFO

# Optional: LangSmith tracing of every LLM/tool call
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=resume-screening

# Streamlit UI
API_URL=http://localhost:8000

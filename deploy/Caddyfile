# TLS-terminating reverse proxy for the compose stack: the only service published on the host.
#   https://<SITE_ADDRESS>/        → Streamlit UI
#   https://<SITE_ADDRESS>/api/... → API (e.g. /api/screenings, /api/health)
# SITE_ADDRESS=localhost (default) uses Caddy's own local CA: browsers warn until it is trusted.
# A public domain name pointing at this host gets a Let's Encrypt certificate automatically.
{$SITE_ADDRESS:localhost} {
	encode zstd gzip

	handle_path /api/* {
		# Metrics are for the internal network (scrape api:8000/metrics), never the internet.
		# Inside this block, where the path has lost its /api prefix: respond is ordered before
		# reverse_proxy, whereas a top-level respond would run after handle_path and never match.
		respond /metrics* 404
		reverse_proxy api:8000
	}

	# Streamlit's websocket is proxied as well
	handle {
		reverse_proxy ui:8501
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		# No other site may frame the UI (clickjacking the Approve button). The CSP leaves scripts
		# and styles alone, as Streamlit's frontend needs inline ones, and locks down the rest.
		X-Frame-Options DENY
		Content-Security-Policy "frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}
}
